#!/usr/bin/python3
"""Check the built/installed application without a model, GPU or daemon."""

import argparse
from importlib import import_module, metadata
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile


def run(module, *arguments, env, cwd):
    result = subprocess.run(
        [sys.executable, "-m", module, *arguments], env=env,
        cwd=cwd, capture_output=True, text=True, timeout=30, check=True,
    )
    return result.stdout.strip()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--expected-version")
    parser.add_argument("--package-root", type=Path,
                        help="Unpacked wheel directory selected by pybuild.")
    args = parser.parse_args()
    if args.package_root is not None:
        package_root = args.package_root.resolve()
        assert (package_root / 'tllama/__init__.py').is_file(), (
            'Missing built TLlama package', str(package_root))
        # installer/previous build caches may contain bytecode independent of
        # the current source. Discard all optimization levels before the first
        # TLlama import. Only explicit build roots are writable test fixtures;
        # installed-package/autopkgtest mode must leave their caches alone.
        caches = sorted((package_root / 'tllama').rglob('*.pyc'))
        for cache in caches:
            cache.unlink()
        print(f'Discarded build bytecode caches: {len(caches)}', flush=True)
        sys.path.insert(0, str(package_root))
    else:
        package_root = Path(import_module('tllama').__file__).resolve().parent.parent
    package = import_module('tllama')
    assert Path(package.__file__).resolve().parent == package_root / 'tllama', (
        'TLlama imported outside selected package root', package.__file__, str(package_root))
    distribution = metadata.distribution("tllama")
    assert Path(distribution.locate_file('tllama')).resolve() == package_root / 'tllama', (
        'TLlama metadata/code roots differ', str(distribution.locate_file('')), str(package_root))
    print('TLlama package smoke imports: ' + str(package_root), flush=True)
    version = distribution.version
    assert version != "0.0.0.dev0", version
    if args.expected_version is not None:
        from packaging.version import Version
        assert version == str(Version(args.expected_version)), (version, args.expected_version)
    scripts = {entry.name: entry.value for entry in
               distribution.entry_points
               if entry.group == "console_scripts"}
    assert scripts == {"tllama": "tllama.cli:main", "tllamad": "tllama.daemon:main"}, scripts
    if args.expected_version is None:
        for command in ("tllama", "tllamad"):
            reply = subprocess.check_output(["/usr/bin/" + command, "--version"], text=True)
            assert reply.strip() == command + " " + version, reply

    # An installed package must supply every supported CLI path, including pull
    # and REPL dependencies, without consulting a user's configuration or store.
    for module in ("anyio", "fastapi", "filetype", "gguf", "httpx",
                   "huggingface_hub", "jinja2", "prompt_toolkit", "pydantic",
                   "tomlkit", "uvicorn"):
        import_module(module)
    with tempfile.TemporaryDirectory(prefix="tllama-package-") as temporary:
        root = Path(temporary)
        env = {name: value for name, value in os.environ.items()
               if not name.startswith("TLLAMA_")}
        env.update(HOME=temporary, XDG_CONFIG_HOME=str(root / "config"),
                   TLLAMA_MODELS=str(root / "models"), PYTHONPATH=str(package_root))
        # Python -m/-c searches its CWD before PYTHONPATH. Use a clean temporary
        # CWD as well as the pinned wheel path, never a checkout/stale build.
        assert run("tllama", "--version", env=env, cwd=root) == "tllama " + version
        assert run("tllama.daemon", "--version", env=env, cwd=root) == "tllamad " + version
        assert "HTTP client" in run("tllama", "--help", env=env, cwd=root)
        assert "--config" in run("tllama.daemon", "--help", env=env, cwd=root)
        config = root / "server.toml"
        config.write_text('[server]\nhost = "127.0.0.1"\nport = 54801\n', encoding="utf-8")
        assert run("tllama.daemon", "--config", str(config), "--check-config", env=env, cwd=root) == "Configuration is valid."
        report = json.loads(run("tllama.daemon", "--config", str(config), "--print-config", env=env, cwd=root))
        assert report["settings"]["server.port"]["value"] == 54801, report
        assert not (root / "models").exists()

        for operation in (("check",), ("prune",), ("stats",), ("inspect", "absent")):
            reply = subprocess.run([sys.executable, "-m", "tllama.daemon", "repo",
                *operation, "--no-config", "--json"], env=env, cwd=root, capture_output=True,
                text=True, timeout=30)
            assert reply.returncode == 1, (operation, reply.stdout, reply.stderr)
            assert not json.loads(reply.stdout)["ok"], reply.stdout
            assert not (root / "models").exists()

        # Exercise the actual ASGI application and version endpoint in process.
        # No listener or native worker is started, and the store stays temporary.
        probe = '''
import asyncio
import httpx
from tllama.main import app
from tllama.version import get_version
async def check():
    async with httpx.AsyncClient(transport=httpx.ASGITransport(app=app), base_url="http://test") as client:
        reply = await client.get("/api/version")
        assert reply.status_code == 200, reply.text
        assert reply.json() == {"version": get_version()}, reply.text
        for path in ('/docs', '/redoc', '/openapi.json', '/docs/oauth2-redirect'):
            reply = await client.get(path)
            assert reply.status_code == 404, (path, reply.text)
asyncio.run(check())

# Qualify optional .inf support from the actual installed/built wheel.
import os
from pathlib import Path
import gguf
from tllama.repository_store import RepositoryStore, prepare_group
from tllama.repository_runtime import ensure_format
from tllama.repository_check import check_repository
from tllama.repository_prune import prune_repository
store = RepositoryStore(Path(os.environ['TLLAMA_MODELS']))
ensure_format(store)
source = store.root.parent / 'original-name.gguf'
writer = gguf.GGUFWriter(str(source), 'llama')
writer.write_header_to_file()
writer.write_kv_data_to_file()
writer.close()
weight, = store.publish(prepare_group([source]))
info = weight.with_suffix('.inf')
assert info.read_text() == source.name + chr(10)
assert check_repository(store, hashes=True)['ok']
info.unlink()
assert check_repository(store, hashes=True)['ok']
assert store.publish(prepare_group([source])) == (weight,)
assert info.read_text() == source.name + chr(10)
assert prune_repository(store, apply=True)['ok']
assert not weight.parent.exists()
'''
        subprocess.run([sys.executable, "-c", probe], env=env, cwd=root, check=True, timeout=30)
    print("TLlama package smoke passed: " + version)


if __name__ == "__main__":
    main()
